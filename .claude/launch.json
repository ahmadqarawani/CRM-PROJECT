{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "backend", "run", "granian", "--interface", "asginl", "--host", "127.0.0.1", "--port", "8000", "config.asgi:application"],
      "port": 8000
